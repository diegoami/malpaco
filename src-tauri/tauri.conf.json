{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Malpaco",
  "version": "0.3.0-alpha.1",
  "identifier": "io.github.diegoami.malpaco",
  "build": {
    "frontendDist": "../release/malpaco-playable",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run package:playable"
  },
  "app": {
    "windows": [
      {
        "title": "Malpaco",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/icon.png"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
