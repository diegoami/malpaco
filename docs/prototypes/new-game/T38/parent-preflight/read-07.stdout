import {expect} from 'vitest';
import * as core from '../../src/core';
import {referenceMap} from '../../src/core/reference-map';
import type {Action,GameOptions,GameState,RuleSet,MatchIdentity} from '../../src/core';
export const COMPOSITION={Anchor:11,Compass:7,Lantern:4,Surge:4,Raid:4,Wild:5,Shield:4,Squall:1} as const;
export type Kind=keyof typeof COMPOSITION;
export interface Deck {drawPile:Kind[];discardPile:Kind[];hands:Record<string,Kind[]>;pendingDiscard?:{player:string}}
export type State=GameState & {cards?:Deck};
export type CardAction=Action|{kind:'discardCard';handIndex:number};
export const api=core as typeof core & {
 cardsRules?:(options?:Pick<GameOptions,'dominationWin'|'roundLimit'>)=>RuleSet;
 CARD_COMPOSITION?:typeof COMPOSITION;HAND_LIMIT?:number;
 cardView?:(state:GameState,viewer:string)=>{drawCount:number;discardCount:number;handCounts:Record<string,number>;hand:readonly Kind[]};
 REFERENCE_CARD_MATCH_IDENTITY?:MatchIdentity;GEOGRAPHIC_CARD_MATCH_IDENTITY?:MatchIdentity;
};
export const settings=(seed=1994):GameOptions=>({...core.defaultOptions(),seed,seats:[{kind:'human'},{kind:'human'},{kind:'human'}],computerStrengths:[],dominationWin:false});
export function opening(seed=1994,geographic=false):State {
 const options=settings(seed),rules=api.cardsRules?.(options)??core.victoryRules(options);
 const r=geographic?core.createGeographicGame(options,rules):core.createReferenceGame(referenceMap,options,rules);
 if(!r.ok)throw Error(r.errors.join(';'));return r.state;
}
export function cards(s:State):Deck {expect(s.cards,'opt-in rules initialize the real deck').toBeDefined();return s.cards!;}
export function act(s:State,a:CardAction):State {const r=core.apply(s,a as Action);if(!r.ok)throw Error(`${JSON.stringify(a)}: ${r.error}`);return r.state;}
export function ready(s:State):State {
 if(s.phase!=='reinforce')return s;
 const id=s.map.provinces.find(p=>s.ownerOf[p.id]===s.players[s.currentPlayer]!.id)!.id;
 if(s.reinforcementPool)s=act(s,{kind:'reinforce',province:id,amount:s.reinforcementPool});
 return act(s,{kind:'endReinforcement'});
}
export const player=(s:State)=>s.players[s.currentPlayer]!.id;
export const canonical=():Kind[]=>Object.entries(COMPOSITION).flatMap(([k,n])=>Array<Kind>(n).fill(k as Kind));
export function conserved(s:State){const c=cards(s),all=[...c.drawPile,...c.discardPile,...Object.values(c.hands).flat()];expect(all.length).toBe(40);expect(Object.fromEntries(Object.keys(COMPOSITION).map(k=>[k,all.filter(x=>x===k).length]))).toEqual(COMPOSITION);}
// Explicit deck fixtures always redistribute the canonical inventory, never duplicate it.
export function arrange(s:State,hand:Kind[]=[],top:Kind[]=['Anchor']):State {
 const c=cards(s),rest=canonical();
 for(const kind of [...hand,...top]){const i=rest.indexOf(kind);if(i<0)throw Error('fixture overdraw');rest.splice(i,1);}
 c.hands=Object.fromEntries(s.players.map(p=>[p.id,[]]));c.hands[player(s)]=[...hand];c.drawPile=[...top,...rest];c.discardPile=[];delete c.pendingDiscard;conserved(s);return s;
}
export function example(decisive=false):{s:State;from:string;to:string;other:string} {
 const s=ready(opening()),me=player(s),enemy=s.players.find(p=>p.id!==me)!.id,third=s.players.find(p=>p.id!==me&&p.id!==enemy)!.id;
 const from=s.map.provinces.find(p=>p.borders.length>=2)!;const [to,other]=from.borders as readonly [string,string,...string[]];
 for(const p of s.map.provinces){s.ownerOf[p.id]=decisive?me:third;s.armies[p.id]=1;}
 s.ownerOf[from.id]=me;s.ownerOf[to]=enemy;s.ownerOf[other]=decisive?me:enemy;s.armies[from.id]=80;
 for(const p of s.players)p.eliminated=!Object.values(s.ownerOf).includes(p.id);
 s.phase='attack';s.reinforcementPool=0;s.capturedThisTurn=false;s.rng=new core.DeterministicRng(0).snapshot();return {s,from:from.id,to,other};
}
export function capture(s:State,from:string,to:string):State {
 for(let n=0;n<128&&s.phase==='attack'&&s.ownerOf[to]!==player(s);n++)s=act(s,{kind:'attack',from,to});
 expect(s.phase).toBe('capture');return act(s,{kind:'captureMove',amount:1});
}
export function frozen<T>(x:T):T{if(x&&typeof x==='object'){Object.freeze(x);Object.values(x).forEach(frozen);}return x;}
export function identity(geographic=false):MatchIdentity {return (geographic?api.GEOGRAPHIC_CARD_MATCH_IDENTITY:api.REFERENCE_CARD_MATCH_IDENTITY)??{boardGenerator:{id:geographic?'geographic':'fixed-reference',version:1},rules:{id:'cards',version:1},actionSchemaVersion:3};}
export {core,referenceMap};
import {describe,it,expect} from 'vitest';
import {api,core,COMPOSITION,opening,cards,canonical,conserved,arrange,ready,act,player,example,capture,frozen,settings,referenceMap} from './card-deck-fixture';
import type {CardAction,State} from './card-deck-fixture';

describe('approved deck and private hands',()=>{
 it('has exactly the approved eight kinds and five-card cap, empty opening hands',()=>{
  const s=opening();expect(api.CARD_COMPOSITION).toEqual(COMPOSITION);expect(api.HAND_LIMIT).toBe(5);
  expect(cards(s).drawPile).toHaveLength(40);expect(cards(s).discardPile).toEqual([]);
  expect(cards(s).hands).toEqual(Object.fromEntries(s.players.map(p=>[p.id,[]])));conserved(s);
 });
 for(const geographic of [false,true])it(`shuffles after the deal and centres on the same rules stream (${geographic})`,()=>{
  const options=settings(),r=geographic?core.createGeographicGame(options,core.victoryRules(options)):core.createReferenceGame(referenceMap,options,core.victoryRules(options));
  if(!r.ok)throw Error(r.errors.join(';'));const old=r.state,s=opening(1994,geographic),rng=core.DeterministicRng.fromSnapshot(old.rng);
  expect(cards(s).drawPile).toEqual(rng.shuffled(canonical()));expect(s.rng).toEqual(rng.snapshot());
  for(const key of ['ownerOf','armies','productionCentres','currentPlayer','computerRngs'] as const)expect(s[key]).toEqual(old[key]);
  expect(old).not.toHaveProperty('cards');expect(opening(1994,geographic)).toEqual(s);expect(cards(opening(1995,geographic)).drawPile).not.toEqual(cards(s).drawPile);
 });
 it('does not reward a non-capturing turn or consume any rules/computer RNG',()=>{
  const s=ready(opening()),before=structuredClone(s),next=act(frozen(s),{kind:'endTurn'});
  expect(cards(next)).toEqual(cards(s));expect(next.rng).toEqual(s.rng);expect(next.computerRngs).toEqual(s.computerRngs);expect(s).toEqual(before);
 });
 it('awards one top card for multiple real captures and never at capture confirmation',()=>{
  const x=example();arrange(x.s,[],['Compass']);const me=player(x.s),n=cards(x.s).drawPile.length;
  let s=capture(frozen(x.s),x.from,x.to);expect(cards(s).hands[me]).toEqual([]);
  s.rng=new core.DeterministicRng(0).snapshot();s=capture(s,x.from,x.other);
  expect(cards(s).drawPile).toHaveLength(n);const done=act(s,{kind:'endTurn'});
  expect(cards(done).hands[me]).toEqual(['Compass']);expect(cards(done).drawPile).toHaveLength(n-1);conserved(done);
 });
 it('a captured turn still earns after a later failed attack exhausts its source',()=>{
  const x=example();arrange(x.s,[],['Lantern']);let s=capture(x.s,x.from,x.to);const me=player(s);
  s.armies[x.from]=2;s.armies[x.other]=50;
  for(let n=0;n<128&&s.armies[x.from]!>1;n++)s=act(s,{kind:'attack',from:x.from,to:x.other});
  expect(s.armies[x.from]).toBe(1);expect(s.ownerOf[x.from]).toBe(me);expect(s.capturedThisTurn).toBe(true);
  s=act(s,{kind:'endTurn'});expect(cards(s).hands[me]).toEqual(['Lantern']);conserved(s);
 });
 it('waits for a chosen discard before drawing, victory or handoff; refuses every other action atomically',()=>{
  const x=example(true);arrange(x.s,['Anchor','Compass','Lantern','Raid','Shield'],['Wild']);let s=capture(x.s,x.from,x.to);const me=player(s);
  const beforeEnd=structuredClone(s);s=act(frozen(s),{kind:'endTurn'});const c=cards(s);
  expect(c.pendingDiscard).toEqual({player:me});expect(c.drawPile).toEqual(cards(beforeEnd).drawPile);expect(s.rng).toEqual(beforeEnd.rng);expect(s.currentPlayer).toBe(beforeEnd.currentPlayer);expect(s.result).toBeUndefined();expect(s.winner).toBe('');expect(s.log).toEqual(beforeEnd.log);
  const snapshot=structuredClone(s);
  const blocked:CardAction[]=[{kind:'endTurn'},{kind:'endReinforcement'},{kind:'reinforce',province:x.from,amount:1},{kind:'attack',from:x.from,to:x.to},{kind:'captureMove'},{kind:'friendlyMove',from:x.from,to:x.to},{kind:'watchComputers'},{kind:'stopGame'},...[-1,5,0.5,NaN,Infinity].map(handIndex=>({kind:'discardCard' as const,handIndex}))];
  for(const a of blocked){expect(core.apply(frozen(s),a as never).ok,JSON.stringify(a)).toBe(false);expect(s).toEqual(snapshot);}
  const done=act(s,{kind:'discardCard',handIndex:2});expect(cards(done).hands[me]).toEqual(['Anchor','Compass','Raid','Shield','Wild']);expect(cards(done).discardPile).toEqual(['Lantern']);expect(done.phase).toBe('finished');expect(done.result?.reason).toBe('conquest');expect(done.history.slice(-2)).toEqual([{kind:'endTurn'},{kind:'discardCard',handIndex:2}]);expect(done.log.filter(e=>e.event==='turn_ended')).toHaveLength(1);conserved(done);
 });
 it('does a friendly transfer once even when its end-turn reward requires discard',()=>{
  const x=example();arrange(x.s,['Anchor','Compass','Lantern','Raid','Shield'],['Wild']);let s=capture(x.s,x.from,x.to);const me=player(s),before=structuredClone(s.armies);
  s=act(s,{kind:'friendlyMove',from:x.from,to:x.to,amount:3});expect(cards(s).pendingDiscard).toEqual({player:me});expect(s.armies[x.from]).toBe(before[x.from]!-3);expect(s.armies[x.to]).toBe(before[x.to]!+3);
  const moved=structuredClone(s.armies);s=act(s,{kind:'discardCard',handIndex:0});expect(s.armies).toEqual(moved);expect(s.history.filter(a=>a.kind==='friendlyMove')).toHaveLength(1);expect(s.log.filter(e=>e.event==='turn_ended')).toHaveLength(1);conserved(s);
 });
 for(const hand of [[],['Anchor','Compass','Lantern','Raid','Shield']] as const)it(`Squall discards itself and all ${hand.length} held cards without replacement`,()=>{
  const x=example();arrange(x.s,[...hand],['Squall']);let s=capture(x.s,x.from,x.to);const me=player(s),beforeDraw=cards(s).drawPile.slice(1);s=act(s,{kind:'endTurn'});
  if(hand.length)s=act(s,{kind:'discardCard',handIndex:1});
  expect(cards(s).hands[me]).toEqual([]);expect(cards(s).drawPile).toEqual(beforeDraw);expect(cards(s).discardPile.slice().sort()).toEqual([...hand,'Squall'].sort());conserved(s);
 });
 it('discards an eliminated enemy hand immediately, before capture move or end turn',()=>{
  const x=example(true);arrange(x.s,[],['Anchor']);const enemy=x.s.ownerOf[x.to]!,c=cards(x.s);
  c.hands[enemy]=[c.drawPile.splice(c.drawPile.indexOf('Shield'),1)[0]!];
  const next=act(frozen(x.s),{kind:'attack',from:x.from,to:x.to});expect(next.phase).toBe('capture');expect(next.players.find(p=>p.id===enemy)!.eliminated).toBe(true);expect(cards(next).hands[enemy]).toEqual([]);expect(cards(next).hands[player(x.s)]).toEqual([]);expect(cards(next).discardPile).toEqual(['Shield']);conserved(next);
 });
 it('returns only the viewer hand and public counts, without mutable aliases or hidden kinds in logs',()=>{
  const x=example();arrange(x.s,[],['Raid']);const s=act(capture(x.s,x.from,x.to),{kind:'endTurn'}),owner=player(x.s);expect(api.cardView).toBeTypeOf('function');
  const other=s.players.find(p=>p.id!==owner)!.id,own=api.cardView!(s,owner),view=api.cardView!(s,other);
  expect(own).toEqual({drawCount:39,discardCount:0,handCounts:Object.fromEntries(s.players.map(p=>[p.id,p.id===owner?1:0])),hand:['Raid']});expect(view.hand).toEqual([]);expect(Object.keys(view).sort()).toEqual(['drawCount','discardCount','handCounts','hand'].sort());
  (own.hand as string[]).push('Wild');(own.handCounts as Record<string,number>)[owner]=999;expect(cards(s).hands[owner]).toEqual(['Raid']);expect(JSON.stringify(s.log)).not.toMatch(/Raid|handIndex|drawPile/);conserved(s);
 });
 it('deep clones card arrays and pending metadata; out-of-phase discard is atomic',()=>{
  const s=arrange(ready(opening()),['Anchor','Compass','Lantern','Raid','Shield']);s.capturedThisTurn=true;const pending=act(s,{kind:'endTurn'}),copy=core.cloneState(pending) as State;
  cards(copy).drawPile.pop();cards(copy).discardPile.push('Squall');cards(copy).hands[player(pending)]!.pop();delete cards(copy).pendingDiscard;
  expect(cards(pending).drawPile).toHaveLength(35);expect(cards(pending).discardPile).toEqual([]);expect(cards(pending).hands[player(pending)]).toHaveLength(5);expect(cards(pending).pendingDiscard).toBeDefined();
  const before=structuredClone(s);expect(core.apply(frozen(s),{kind:'discardCard',handIndex:0} as never).ok).toBe(false);expect(s).toEqual(before);
 });
});
import {readFileSync} from 'node:fs';
import {describe,it,expect} from 'vitest';
import {api,core,cards,opening,settings,identity,conserved,act,player,arrange,example,capture,canonical,frozen} from './card-deck-fixture';
import type {State,CardAction} from './card-deck-fixture';
import type {Action,GameOptions} from '../../src/core';

function ordinary(s:State,finish=false):CardAction {
 if(cards(s).pendingDiscard)return {kind:'discardCard',handIndex:0};
 if(s.pendingCapture)return {kind:'captureMove',amount:1};
 if(s.phase==='reinforce'){
  if(!s.reinforcementPool)return {kind:'endReinforcement'};
  const own=s.map.provinces.filter(p=>s.ownerOf[p.id]===player(s));
  const border=own.filter(p=>[...p.borders,...p.seaLanes].some(id=>s.ownerOf[id]!==player(s)));
  const from=(border.length?border:own).sort((a,b)=>s.armies[b.id]!-s.armies[a.id]!||a.id.localeCompare(b.id))[0]!;
  return {kind:'reinforce',province:from.id,amount:s.reinforcementPool};
 }
 const attacks=core.legalAttacks(s).filter((a):a is Extract<Action,{kind:'attack'}>=>a.kind==='attack'&&s.armies[a.from]!>s.armies[a.to]!+1).sort((a,b)=>s.armies[a.to]!-s.armies[b.to]!||s.armies[b.from]!-s.armies[a.from]!||a.from.localeCompare(b.from)||a.to.localeCompare(b.to));
 return (!s.capturedThisTurn||finish)&&attacks[0]?attacks[0]:{kind:'endTurn'};
}
function replay(s:State,options:GameOptions,geographic=false):State {
 const text=core.serializeVersionedMatch(options,s.history,identity(geographic)),payload=JSON.parse(text);
 expect(Object.keys(payload).sort()).toEqual(['format','version','boardGenerator','rules','actionSchemaVersion','options','actions'].sort());
 expect(payload).not.toHaveProperty('cards');expect(payload).not.toHaveProperty('rng');
 const loaded=core.deserializeVersionedMatch(text);expect(loaded.identity).toEqual(identity(geographic));expect(loaded.state).toEqual(s);conserved(loaded.state);return loaded.state;
}

describe('deck replay and same-stream continuation',()=>{
 it('reshuffles the actual discard pile deterministically, preserving pending input and computer streams',()=>{
  const x=example();arrange(x.s,['Anchor','Compass','Lantern','Raid','Shield'],['Wild']);let s=capture(x.s,x.from,x.to),c=cards(s),me=player(s);
  c.discardPile=c.drawPile;c.drawPile=[];const input=structuredClone(s),rng=core.DeterministicRng.fromSnapshot(s.rng);
  const pending=act(frozen(s),{kind:'endTurn'});expect(pending.rng).toEqual(input.rng);expect(cards(pending).drawPile).toEqual([]);
  const chosen=cards(pending).hands[me]![2]!,shuffled=rng.shuffled([...cards(pending).discardPile,chosen]);
  const next=act(frozen(pending),{kind:'discardCard',handIndex:2});
  expect(next.rng).toEqual(rng.snapshot());expect(next.computerRngs).toEqual(input.computerRngs);expect(cards(next).drawPile).toEqual(shuffled.slice(1));
  const expected=cards(input).hands[me]!.filter((_,i)=>i!==2);if(shuffled[0]==='Squall'){expect(cards(next).hands[me]).toEqual([]);expect(cards(next).discardPile.slice().sort()).toEqual([...expected,'Squall'].sort());}else {expect(cards(next).hands[me]).toEqual([...expected,shuffled[0]]);expect(cards(next).discardPile).toEqual([]);}
  expect(s).toEqual(input);conserved(next);expect(act(pending,{kind:'discardCard',handIndex:2})).toEqual(next);
 });
 for(const geographic of [false,true])it(`real production codec reconstructs card rules and legal action/RNG continuation (${geographic})`,()=>{
  const options=settings(37);let s=opening(37,geographic);cards(s);
  for(let i=0;i<100&&s.phase!=='finished';i++)s=act(s,ordinary(s));
  expect(s.history.some(a=>a.kind==='attack')).toBe(true);expect(s.history.some(a=>a.kind==='captureMove')).toBe(true);
  let loaded=replay(s,options,geographic);
  for(let n=0;n<30&&s.phase!=='finished';n++){const a=ordinary(s);s=act(s,a);loaded=act(loaded,a);expect(loaded).toEqual(s);}
  expect(loaded.computerRngs).toEqual(opening(37,geographic).computerRngs);
 },30000);
 it('reconstructs a reached full-hand choice and actual reshuffle from options and ordinary actions',()=>{
  cards(opening());
  const read=(name:string)=>readFileSync(new URL('../../docs/prototypes/new-game/T37/fixtures/'+name,import.meta.url),'utf8');
  const beforePayload=JSON.parse(read('reshuffle-before-match.json')),afterPayload=JSON.parse(read('reshuffle-match.json'));
  expect(beforePayload.actions).toHaveLength(328);expect(afterPayload.actions).toHaveLength(329);
  const before=core.deserializeVersionedMatch(JSON.stringify(beforePayload)).state as State;
  expect(cards(before).pendingDiscard).toEqual({player:player(before)});expect(cards(before).drawPile).toEqual([]);expect(before.rng).toEqual({seed:2,state:2233696394});conserved(before);
  const saved=replay(before,beforePayload.options);const next=act(saved,{kind:'discardCard',handIndex:0});
  const after=core.deserializeVersionedMatch(JSON.stringify(afterPayload)).state as State;
  expect(next).toEqual(after);expect(cards(after).drawPile).toHaveLength(25);expect(after.rng).toEqual({seed:2,state:778201463});conserved(after);
  // Continue through ordinary turn preparation and the next actual dice draw.
  let left=after,right=next,attackSeen=false;
  for(let i=0;i<100&&left.phase!=='finished';i++){const a=ordinary(left);left=act(left,a);right=act(right,a);expect(right).toEqual(left);if(a.kind==='attack'){attackSeen=true;break;}}
  expect(attackSeen).toBe(true);expect(left.computerRngs).toEqual(before.computerRngs);
 },30000);
 it('the real decisive capturing turn waits for discard and rewards before replayed victory',()=>{
  cards(opening());
  const read=(name:string)=>readFileSync(new URL('../../docs/prototypes/new-game/T37/fixtures/'+name,import.meta.url),'utf8');
  const beforePayload=JSON.parse(read('decisive-before-match.json')),afterPayload=JSON.parse(read('decisive-match.json'));
  expect(beforePayload.actions).toHaveLength(194);expect(afterPayload.actions).toHaveLength(195);
  const before=core.deserializeVersionedMatch(JSON.stringify(beforePayload)).state as State,me=player(before);
  expect(before.capturedThisTurn).toBe(true);expect(before.result).toBeUndefined();expect(before.winner).toBe('');expect(cards(before).pendingDiscard).toEqual({player:me});
  expect(cards(before).hands[me]).toEqual(['Anchor','Raid','Lantern','Compass','Compass']);expect(cards(before).drawPile[0]).toBe('Anchor');expect(cards(before).drawPile).toHaveLength(34);
  const next=act(frozen(before),{kind:'discardCard',handIndex:0});const after=core.deserializeVersionedMatch(JSON.stringify(afterPayload)).state as State;
  expect(next).toEqual(after);expect(after.phase).toBe('finished');expect(after.result?.reason).toBe('domination');expect(after.winner).toBe(me);expect(cards(after).drawPile).toHaveLength(33);expect(cards(after).hands[me]).toHaveLength(5);expect(after.rng).toEqual({seed:37,state:1970355341});
  expect(after.log.filter(e=>e.event==='turn_ended')).toHaveLength(before.log.filter(e=>e.event==='turn_ended').length+1);conserved(after);replay(after,afterPayload.options);
 },30000);
 it('keeps historical victory and legacy codecs distinct and rejects unsupported card identity tuples',()=>{
  const options=settings(37);cards(opening(37));
  for(const old of [core.REFERENCE_MATCH_IDENTITY,core.GEOGRAPHIC_MATCH_IDENTITY]){
   const text=core.serializeVersionedMatch(options,[],old),loaded=core.deserializeVersionedMatch(text);expect(loaded.state).not.toHaveProperty('cards');expect(loaded.identity).toEqual(old);
   expect(()=>core.deserializeVersionedMatch(JSON.stringify({...JSON.parse(text),actions:[{kind:'discardCard',handIndex:0}]}))).toThrow();
  }
  const old=core.serializeMatch(options,[]);expect(core.deserializeVersionedMatch(old).state).not.toHaveProperty('cards');
  const value=JSON.parse(core.serializeVersionedMatch(options,[],identity()));
  for(const patch of [{rules:{id:'cards',version:2}},{rules:{id:'cards',version:3}},{actionSchemaVersion:2},{actionSchemaVersion:4},{boardGenerator:{id:'geographic',version:2}},{boardGenerator:{id:'unknown',version:1}}])expect(()=>core.deserializeVersionedMatch(JSON.stringify({...value,...patch}))).toThrow();
 });
 it('rejects malformed discard shapes and forged snapshots through the real decoder',()=>{
  cards(opening());const base=JSON.parse(core.serializeVersionedMatch(settings(),[],identity()));
  for(const action of [{kind:'discardCard'},{kind:'discardCard',handIndex:-1},{kind:'discardCard',handIndex:0.5},{kind:'discardCard',handIndex:'0'},{kind:'discardCard',handIndex:0,card:'Anchor'},{kind:'discardCard',handIndex:0,extra:true}])expect(()=>core.deserializeVersionedMatch(JSON.stringify({...base,actions:[action]}))).toThrow();
  expect(()=>core.deserializeVersionedMatch(JSON.stringify({...base,cards:{drawPile:canonical()}}))).toThrow();
  expect(()=>core.deserializeVersionedMatch(JSON.stringify({...base,rules:{...base.rules,extra:1}}))).toThrow();
 });
});
