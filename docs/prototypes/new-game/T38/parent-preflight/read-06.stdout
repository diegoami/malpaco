import type { CardState } from './cards';
// Plain data types for the rules core. Everything here is JSON-serialisable
// except the map, which is shared and never mutated once loaded.

export type Point = readonly [number, number];

export interface Province {
  readonly id: string;
  readonly name: string;
  readonly island: string;
  /** Land neighbours: same island, authored and symmetric. */
  readonly borders: readonly string[];
  /** Water neighbours: always on another island. */
  readonly seaLanes: readonly string[];
  readonly polygon: readonly Point[];
  readonly labelAt: Point;
}

export interface Island {
  readonly id: string;
  readonly name: string;
  readonly bonus: number;
  readonly provinces: readonly string[];
}

export interface GameMap {
  readonly id: string;
  readonly name: string;
  readonly bounds: { readonly x: number; readonly y: number; readonly width: number; readonly height: number };
  readonly provinces: readonly Province[];
  readonly islands: readonly Island[];
}

export interface Player {
  readonly id: string;
  readonly name: string;
  /** "human" or "computer" (C-PLY-02, decision 3). Defaults to "human" when absent. */
  readonly kind?: "human" | "computer";
  /** A computer seat's difficulty (computer.md A1, A2, A3). Humans ignore it. */
  readonly difficulty?: "Easy" | "Normal" | "Hard";
  eliminated: boolean;
}

/** How many dice a stack rolls: clamp(armies - minus, 0, max). */
export interface DiceRule {
  readonly max: number;
  readonly minus: number;
}

/** The Classic preset's combat block, as data (core/rules/rule_set.gd, Combat). */
export interface CombatRules {
  readonly attackRule: "match" | "classic" | "threshold";
  readonly attackRatio: number;
  readonly minArmiesToAttack: number;
  readonly attackerDice: DiceRule;
  readonly defenderDice: DiceRule;
  readonly ties: "defender" | "attacker" | "reroll";
  readonly failurePenalty: "loseProvince" | "endPhase" | "none";
  readonly capture: "diceCount" | "all" | "one" | "choice";
}

export interface SetupRules {
  readonly startingArmies: number;
  readonly distributionPool: number;
  readonly shortStackBonus: number;
}

export interface RuleSet {
  readonly cards?: "deck-v1" | "trade-v1" | "raid-v1";
  readonly id: string;
  /** Opt-in C-MOV-01..03; omitted by the stable legacy presets. */
  readonly movement?: "adjacent";
  /** [designed] T11 turn flow; Classic remains the legacy attack-only shortcut. */
  readonly turnSequence: "classic" | "reinforcement";
  readonly setup: SetupRules;
  readonly combat: CombatRules;
  /** Conquest only, as in Classic. */
  readonly victory: readonly "conquest"[];
  /** Opt-in pinned end-of-turn victory; earlier presets keep their timing. */
  readonly victoryOptions?: { readonly dominationWin: boolean; readonly roundLimit: 20 | 30 | 40 | null };
}

export type Phase = "reinforce" | "attack" | "capture" | "redeploy" | "human-loss" | "finished";

export interface FinalStanding {
  readonly player: string;
  readonly countries: number;
  readonly armies: number;
}

export interface GameResult {
  readonly reason: "conquest" | "last-seat" | "domination" | "round-limit" | "no-human-left";
  readonly standings: FinalStanding[];
}

/** Total move-in bounds, including the one army provisionally moved at capture. */
export interface PendingCapture {
  readonly from: string;
  readonly to: string;
  readonly min: number;
  readonly max: number;
  readonly defaultAmount: number;
}

export interface RngSnapshot {
  readonly seed: number;
  readonly state: number;
}

export type Action =
  | { readonly kind: "discardCard"; readonly handIndex: number }
  | { readonly kind: "reinforce"; readonly province: string; readonly amount: number }
  | { readonly kind: "endReinforcement" }
  | { readonly kind: "attack"; readonly from: string; readonly to: string }
  | { readonly kind: "endTurn" }
  | { readonly kind: "captureMove"; readonly amount?: number }
  | { readonly kind: "friendlyMove"; readonly from: string; readonly to: string; readonly amount?: number }
  | { readonly kind: "watchComputers" }
  | { readonly kind: "stopGame" };

export interface AttackOutcome {
  readonly event: "attack";
  readonly turn: number;
  readonly from: string;
  readonly to: string;
  readonly attacker: string;
  readonly defender: string;
  readonly attackerRolls: readonly number[];
  readonly defenderRolls: readonly number[];
  readonly attackerLosses: number;
  readonly defenderLosses: number;
  readonly captured: boolean;
  readonly penalty: boolean;
  readonly endsPhase: boolean;
  /** Armies moved into a captured province. */
  readonly moved: number;
}

export type LogEntry =
  | { readonly event: "game_started"; readonly seed: number; readonly players: number }
  | AttackOutcome
  | { readonly event: "eliminated"; readonly player: string; readonly turn: number }
  | { readonly event: "victory"; readonly player: string; readonly turn: number }
  | { readonly event: "turn_ended"; readonly player: string; readonly turn: number };

export interface GameState {
  cards?: CardState;
  readonly map: GameMap;
  readonly rules: RuleSet;
  readonly players: Player[];
  ownerOf: Record<string, string>;
  armies: Record<string, number>;
  currentPlayer: number;
  phase: Phase;
  /** Present only during the opt-in capture-choice protocol. */
  pendingCapture?: PendingCapture;
  /** Unplaced income available during a reinforcement phase. */
  reinforcementPool: number;
  turnNumber: number;
  /** Fixed seeded first-seat index; retained even after that seat is eliminated. */
  roundOrigin?: number;
  /** Suppresses repeated loss prompts after the ordinary Watch action. */
  watchingComputers?: boolean;
  result?: GameResult;
  capturedThisTurn: boolean;
  /**
   * The game's own RNG stream. Every rules draw (the board, the deal,
   * starting armies, the first seat, dice, card draws, events) reads from
   * here (C-RND-03).
   */
  rng: RngSnapshot;
  /**
   * Per-computer-seat RNG streams, seeded from the game seed and the seat
   * number. Used by the computer opponent only; never by the rules (so the
   * game's draws are not perturbed by computer play, C-RND-03).
   */
  computerRngs: Record<string, RngSnapshot>;
  log: LogEntry[];
  history: Action[];
  winner: string;
  /** Three uniformly selected opening production centres (C-CEN-01, C-CEN-04). */
  productionCentres: string[];
}

export type ApplyResult =
  | { readonly ok: true; readonly state: GameState; readonly outcome: AttackOutcome | null }
  | { readonly ok: false; readonly error: string };
/**
 * Owner-approved [designed] card rules, pinned variety.md at ae298e37:
 * https://github.com/diegoami/isle-wars-archaeology/blob/ae298e37c2f5177039e55767607f9345b6cb0e7a/design/variety.md
 * Local T23 inventory variety-009..017 gives every copy count; 018..028 gives
 * shuffle/draw order, five-card limit and Squall; 040 gives elimination discard.
 *
 * [designed] deck-v1 replay protocol: canonical kind order is the composition
 * property order below; copies are contiguous before Fisher-Yates; draw top is
 * index zero; discards append in existing hand order (then Squall). Searched the
 * pinned variety inventory and existing RNG/setup/save seams: the design leaves
 * those representations unspecified. They are frozen for cards/1 + schema 3.
 */
import { DeterministicRng } from './rng';
import type { GameState } from './types';
export type CardKind = 'Anchor'|'Compass'|'Lantern'|'Surge'|'Raid'|'Wild'|'Shield'|'Squall';
export const CARD_COMPOSITION: Readonly<Record<CardKind,number>> = Object.freeze({Anchor:11,Compass:7,Lantern:4,Surge:4,Raid:4,Wild:5,Shield:4,Squall:1});
export const HAND_LIMIT = 5;
export interface CardState {drawPile:CardKind[];discardPile:CardKind[];hands:Record<string,CardKind[]>;pendingDiscard?:{readonly player:string}}
export interface CardView {readonly drawCount:number;readonly discardCount:number;readonly handCounts:Readonly<Record<string,number>>;readonly hand:readonly CardKind[]}
export function cardView(state:GameState,viewer:string):CardView {
 const c=state.cards;return {drawCount:c?.drawPile.length??0,discardCount:c?.discardPile.length??0,handCounts:Object.fromEntries(state.players.map(p=>[p.id,c?.hands[p.id]?.length??0])),hand:[...(c?.hands[viewer]??[])]};
}
/** Stable deck-v1 protocol: kind order as above, top at index zero. */
export function initializeCards(state:GameState,rng:DeterministicRng):void {
 if(state.rules.cards!=='deck-v1')return;
 const cards=(Object.entries(CARD_COMPOSITION) as [CardKind,number][]).flatMap(([k,n])=>Array<CardKind>(n).fill(k));
 state.cards={drawPile:rng.shuffled(cards),discardPile:[],hands:Object.fromEntries(state.players.map(p=>[p.id,[]]))};
 state.rng=rng.snapshot();
}
export function drawReward(state:GameState):void {
 const c=state.cards!,player=state.players[state.currentPlayer]!.id;
 if(!c.drawPile.length){const rng=DeterministicRng.fromSnapshot(state.rng);c.drawPile=rng.shuffled(c.discardPile);c.discardPile=[];state.rng=rng.snapshot();}
 const card=c.drawPile.shift();if(!card)throw Error('Card conservation violated: no card to draw');
 if(card==='Squall'){c.discardPile.push(...c.hands[player]!,card);c.hands[player]=[];}else c.hands[player]!.push(card);
}
import { initializeCards } from './cards';
import { DeterministicRng } from "./rng";
import { reinforcementIncome } from "./reinforcement";
import type { GameMap, GameState, Player, RuleSet } from "./types";
import type { GameOptions } from "./options";
import { defaultOptions } from "./options";

/** The generated-game combat preset, per C-CMB-01..11 and C-OWN-01. */
export function malpacoRules(): RuleSet {
  const classic = classicRules();
  return {
    ...classic,
    id: "malpaco",
    turnSequence: "reinforcement",
    combat: {
      ...classic.combat,
      attackRule: "classic", // C-CMB-02: no defender-strength gate.
      minArmiesToAttack: 2, // C-CMB-01, C-CMB-03: one minimum for every seat.
      attackerDice: { max: 1, minus: 1 }, // C-CMB-04: one six-sided die per exchange.
      defenderDice: { max: 1, minus: 0 }, // C-CMB-04: one six-sided die per exchange.
      ties: "reroll", // C-CMB-05: reroll ties until unequal.
      failurePenalty: "none", // C-CMB-09: a one-army attacker keeps its country.
      capture: "all", // C-OWN-01: move in all but one, without clipping.
    },
  };
}

/**
 * Opt-in C-OWN-01 move-in choice and end-of-turn conquest (core-rules.md,
 * pinned ae298e37, Ownership change / Victory). Legacy presets stay stable.
 */
export function captureChoiceRules(): RuleSet {
  const rules = malpacoRules();
  return { ...rules, id: "malpaco-capture-choice", combat: { ...rules.combat, capture: "choice" } };
}

/** Pinned core-rules.md Movement, ae298e37: one adjacent move ending the turn. */
export function friendlyMoveRules(): RuleSet {
  return { ...captureChoiceRules(), id: "malpaco-friendly-move", movement: "adjacent" };
}

/** Pinned core-rules.md Victory / The turn, ae298e37; options use the setup vocabulary. */
export function victoryRules(options: Pick<GameOptions, "dominationWin" | "roundLimit"> = defaultOptions()): RuleSet {
  return { ...friendlyMoveRules(), id: "malpaco-victory",
    victoryOptions: { dominationWin: options.dominationWin, roundLimit: options.roundLimit } };
}

/** Frozen T37 deck-only stage; later stages must retain this factory's semantics. */
export function cardsRules(options: Pick<GameOptions,"dominationWin"|"roundLimit"> = defaultOptions()):RuleSet {
 return {...victoryRules(options),id:'malpaco-cards',cards:'deck-v1'};
}

/** Classic combat remains available to the legacy spike entry points. */
export function classicRules(): RuleSet {
  return {
    id: "classic",
    turnSequence: "classic",
    setup: { startingArmies: 1, distributionPool: 10, shortStackBonus: 1 },
    combat: {
      attackRule: "match",
      attackRatio: 1.0,
      minArmiesToAttack: 2,
      attackerDice: { max: 3, minus: 1 },
      defenderDice: { max: 2, minus: 0 },
      ties: "defender",
      failurePenalty: "loseProvince",
      capture: "diceCount",
    },
    victory: ["conquest"],
  };
}

export function activePlayer(state: GameState): Player | undefined {
  return state.players[state.currentPlayer];
}

export function ownerOf(state: GameState, provinceId: string): string {
  return state.ownerOf[provinceId] ?? "";
}

export function armyCount(state: GameState, provinceId: string): number {
  return state.armies[provinceId] ?? 0;
}

export function provincesOf(state: GameState, playerId: string): string[] {
  return state.map.provinces.filter((p) => ownerOf(state, p.id) === playerId).map((p) => p.id);
}

export function armyTotal(state: GameState, playerId: string): number {
  return provincesOf(state, playerId).reduce((sum, id) => sum + armyCount(state, id), 0);
}

export function livingPlayers(state: GameState): Player[] {
  return state.players.filter((p) => !p.eliminated);
}

/** A deep copy, so applying an action never touches the state it was given. The map and rules are shared. */
export function cloneState(state: GameState): GameState {
  return {
    ...(state.cards ? {cards:{drawPile:[...state.cards.drawPile],discardPile:[...state.cards.discardPile],hands:Object.fromEntries(Object.entries(state.cards.hands).map(([p,h])=>[p,[...h]])),...(state.cards.pendingDiscard?{pendingDiscard:{...state.cards.pendingDiscard}}:{})}} : {}),
    map: state.map,
    rules: state.rules,
    players: state.players.map((p) => ({ ...p })),
    ownerOf: { ...state.ownerOf },
    armies: { ...state.armies },
    currentPlayer: state.currentPlayer,
    phase: state.phase,
    ...(state.pendingCapture ? { pendingCapture: { ...state.pendingCapture } } : {}),
    reinforcementPool: state.reinforcementPool,
    turnNumber: state.turnNumber,
    ...(state.roundOrigin !== undefined ? { roundOrigin: state.roundOrigin } : {}),
    ...(state.watchingComputers !== undefined ? { watchingComputers: state.watchingComputers } : {}),
    ...(state.result ? { result: { ...state.result, standings: state.result.standings.map(row => ({ ...row })) } } : {}),
    capturedThisTurn: state.capturedThisTurn,
    rng: { ...state.rng },
    computerRngs: Object.fromEntries(Object.entries(state.computerRngs).map(([k, v]) => [k, { ...v }])),
    log: [...state.log],
    history: [...state.history],
    winner: state.winner,
    productionCentres: [...(state.productionCentres ?? [])],
  };
}

/**
 * Deals a new game, ported from core/rules/game_setup.gd: a round-robin deal
 * from a shuffled order, one starting army each, then each player's opening
 * pool (with the short-stack bonus).
 *
 * SPIKE STAND-IN: Godot has players place the pool by hand, one army at a
 * time. The slice has no placement UI, so the pool is spread on the player's
 * own provinces by the seeded RNG. The deal and the pool sizes are as in
 * core/; only who chooses the provinces differs. Centres, reinforcements and
 * hazards are not ported.
 *
 * Two overloads: `newGame(map, rules, players, seed)` (the spike's
 * four-argument form) and `newGame(map, rules, options)` (C-SET-01: the
 * new-game entry point takes a full GameOptions record and uses its
 * `seed`).
 */
export function newGame(map: GameMap, rules: RuleSet, options: GameOptions): GameState;
export function newGame(map: GameMap, rules: RuleSet, players: readonly Player[], seed: number): GameState;
export function newGame(
  map: GameMap,
  rules: RuleSet,
  playersOrOptions: readonly Player[] | GameOptions,
  seed?: number,
): GameState {
  if (isPlayerList(playersOrOptions)) {
    return newGameWithPlayers(map, rules, playersOrOptions, seed ?? 0);
  }
  return newGameFromOptions(map, rules, playersOrOptions, playersOrOptions.seed);
}

/** Type guard for the array branch of the newGame overload. */
function isPlayerList(value: readonly Player[] | GameOptions): value is readonly Player[] {
  return Array.isArray(value);
}

/**
 * Internal implementation: take a pre-built Player list and a seed, do the
 * spike's deal. Not exported.
 */
function newGameWithPlayers(map: GameMap, rules: RuleSet, playerList: readonly Player[], seed: number): GameState {
  const rng = new DeterministicRng(seed);
  const players = playerList.map((p) => ({ ...p, kind: p.kind ?? "human" }));
  const ownerOfMap: Record<string, string> = {};
  const armies: Record<string, number> = {};

  const ids = rng.shuffled(map.provinces.map((p) => p.id));
  ids.forEach((id, seat) => {
    const holder = players[seat % players.length] as Player;
    ownerOfMap[id] = holder.id;
    armies[id] = rules.setup.startingArmies;
  });

  const holdings = (playerId: string) => map.provinces.map((p) => p.id).filter((id) => ownerOfMap[id] === playerId);
  const most = Math.max(...players.map((p) => holdings(p.id).length));
  for (const player of players) {
    const mine = holdings(player.id);
    const bonus = most - mine.length > 0 ? rules.setup.shortStackBonus : 0;
    const pool = rules.setup.distributionPool + bonus;
    for (let i = 0; i < pool; i++) {
      const pick = mine[rng.nextInt(0, mine.length - 1)] as string;
      armies[pick] = (armies[pick] ?? 0) + 1;
    }
  }

  // Per-seat computer streams, seeded from the game seed and the seat number
  // (C-RND-03). The computer opponent draws from these; the rules never do.
  const computerRngs: Record<string, { seed: number; state: number }> = {};
  players.forEach((player, idx) => {
    if (player.kind === "computer") {
      const child = DeterministicRng.subStream(seed, idx);
      computerRngs[player.id] = child.snapshot();
    }
  });

  const state: GameState = {
    map,
    rules,
    players,
    ownerOf: ownerOfMap,
    armies,
    currentPlayer: 0,
    phase: rules.turnSequence === "reinforcement" ? "reinforce" : "attack",
    reinforcementPool: 0,
    turnNumber: 1,
    ...(rules.victoryOptions ? { roundOrigin: 0 } : {}),
    capturedThisTurn: false,
    rng: rng.snapshot(),
    computerRngs,
    log: [{ event: "game_started", seed, players: players.length }],
    history: [],
    winner: "",
    productionCentres: [],
  };
  initializeCards(state,rng);
  if (rules.turnSequence === "reinforcement") {
    const active = state.players[state.currentPlayer]!;
    state.reinforcementPool = reinforcementIncome(state, active.id).total;
  }
  return state;
}

/**
 * Build a Player list from the seat specs and computerStrengths in
 * GameOptions, then call newGameWithPlayers. The default name is "Seat N"
 * with the seat number; the id is the player colour (T52 sets the colour
 * palette). Each computer seat is given its difficulty from
 * options.computerStrengths, in seat order; humans have no difficulty.
 */
export function newGameFromOptions(map: GameMap, rules: RuleSet, options: GameOptions, seed: number): GameState {
  let computerIdx = 0;
  const playerList: Player[] = options.seats.map((seat, idx) => {
    if (seat.kind === "computer") {
      const difficulty = options.computerStrengths[computerIdx++];
      if (difficulty === undefined) {
        throw new Error(`computerStrengths missing entry for seat ${idx + 1}`);
      }
      return {
        id: `seat${idx + 1}`,
        name: `Seat ${idx + 1}`,
        kind: "computer",
        difficulty,
        eliminated: false,
      };
    }
    return {
      id: `seat${idx + 1}`,
      name: `Seat ${idx + 1}`,
      kind: "human",
      eliminated: false,
    };
  });
  return newGameWithPlayers(map, rules, playerList, seed);
}
import { drawReward, HAND_LIMIT } from './cards';
import { attackTargets, resolve, whyNot } from "./combat";
import { DeterministicRng } from "./rng";
import { reinforcementIncome } from "./reinforcement";
import { whyNotFriendlyMove } from "./movement";
import { activePlayer, cloneState, livingPlayers, provincesOf } from "./state";
import { nextLivingTurn, resolveTurnVictory } from "./victory";
import type { Action, ApplyResult, GameState, Player } from "./types";

// The engine's one way in: apply(state, action). Total, deterministic, no I/O,
// no ambient randomness. Ported from core/rules/rules.gd, restricted to the
// slice: reinforcement placement, the attack phase and ending a turn.

/** Every attack the active player could declare. */
export function legalAttacks(state: GameState): Action[] {
  const mover = activePlayer(state);
  if (!mover || state.phase !== "attack") return [];
  const found: Action[] = [];
  for (const from of provincesOf(state, mover.id)) {
    for (const to of attackTargets(state, from)) found.push({ kind: "attack", from, to });
  }
  return found;
}

export function apply(state: GameState, action: Action): ApplyResult {
  if (state.phase === "finished") return { ok: false, error: "the game is over" };
  if (state.phase === "human-loss" && action.kind !== "watchComputers" && action.kind !== "stopGame") {
    return { ok: false, error: "choose whether to watch the computers or stop" };
  }
  if (!activePlayer(state)) return { ok: false, error: "no player to act" };
  if ((state.pendingCapture || state.phase === "capture") && action.kind !== "captureMove") {
    return { ok: false, error: "choose the capture move-in before another action" };
  }

  if (state.cards?.pendingDiscard && action.kind !== 'discardCard') return {ok:false,error:'choose a discard before drawing'};
  const next = cloneState(state);
  const result = dispatch(next, action);
  if (result.ok) result.state.history.push(action);
  return result;
}

function dispatch(next: GameState, action: Action): ApplyResult {
  switch (action.kind) {
    case 'discardCard': return discardCard(next,action.handIndex);
    case "reinforce":
      return reinforce(next, action.province, action.amount);
    case "endReinforcement":
      return endReinforcement(next);
    case "attack":
      return attack(next, action.from, action.to);
    case "endTurn":
      return endTurn(next);
    case "captureMove":
      return captureMove(next, action.amount);
    case "friendlyMove":
      return friendlyMove(next, action.from, action.to, action.amount);
    case "watchComputers":
    case "stopGame":
      return humanLossChoice(next, action.kind);
    default:
      return { ok: false, error: "unknown action" };
  }
}

function reinforce(state: GameState, provinceId: string, amount: number): ApplyResult {
  if (state.rules.turnSequence !== "reinforcement" || state.phase !== "reinforce") {
    return { ok: false, error: "reinforcements happen in the reinforcement phase" };
  }
  if (!Number.isSafeInteger(amount) || amount <= 0) {
    return { ok: false, error: "reinforcement amount must be a positive integer" };
  }
  const mover = activePlayer(state)!;
  if (!state.map.provinces.some((province) => province.id === provinceId)) {
    return { ok: false, error: "unknown province" };
  }
  if (state.ownerOf[provinceId] !== mover.id) {
    return { ok: false, error: "you may reinforce only your own provinces" };
  }
  if (amount > state.reinforcementPool) {
    return { ok: false, error: "reinforcement amount exceeds the remaining pool" };
  }
  state.armies[provinceId] = (state.armies[provinceId] ?? 0) + amount;
  state.reinforcementPool -= amount;
  return { ok: true, state, outcome: null };
}

function endReinforcement(state: GameState): ApplyResult {
  if (state.rules.turnSequence !== "reinforcement" || state.phase !== "reinforce") {
    return { ok: false, error: "not in the reinforcement phase" };
  }
  if (state.reinforcementPool !== 0) {
    return { ok: false, error: "place all reinforcements before attacking" };
  }
  state.phase = "attack";
  return { ok: true, state, outcome: null };
}

function attack(state: GameState, from: string, to: string): ApplyResult {
  if (state.phase !== "attack") return { ok: false, error: "attacks happen in the attack phase" };
  const refusal = whyNot(state, from, to);
  if (refusal !== "") return { ok: false, error: refusal };

  const rng = DeterministicRng.fromSnapshot(state.rng);
  const outcome = resolve(state, from, to, rng);
  state.rng = rng.snapshot();
  state.log.push(outcome);
  if (outcome.captured) {
    state.capturedThisTurn = true;
    checkElimination(state);
    if (state.rules.combat.capture !== "choice" && checkVictory(state)) return { ok: true, state, outcome };
  }
  if (outcome.endsPhase) state.phase = "redeploy";
  return { ok: true, state, outcome };
}

function captureMove(state: GameState, requested: number | undefined): ApplyResult {
  const choice = state.pendingCapture;
  if (state.phase !== "capture" || !choice) return { ok: false, error: "no capture move-in is pending" };
  const amount = requested === undefined ? choice.defaultAmount : requested;
  if (!Number.isSafeInteger(amount) || amount < choice.min || amount > choice.max) {
    return { ok: false, error: "capture amount must be an integer within the pending bounds" };
  }
  const additional = amount - choice.min;
  state.armies[choice.from] = state.armies[choice.from]! - additional;
  state.armies[choice.to] = state.armies[choice.to]! + additional;
  delete state.pendingCapture;
  state.phase = "attack";
  return { ok: true, state, outcome: null };
}

function friendlyMove(state: GameState, from: string, to: string, requested: number | undefined): ApplyResult {
  const refusal = whyNotFriendlyMove(state, from, to);
  if (refusal) return { ok: false, error: refusal };
  const maximum = state.armies[from]! - 1;
  const amount = requested === undefined ? maximum : requested;
  if (!Number.isSafeInteger(amount) || amount < 1 || amount > maximum) {
    return { ok: false, error: "Move a whole number of armies and leave at least one behind." };
  }
  state.armies[from] = state.armies[from]! - amount;
  state.armies[to] = state.armies[to]! + amount;
  return endTurn(state);
}

/** Passes play to the next living player after the selected ruleset's turn phases. */
function endTurn(state: GameState): ApplyResult {
  if (state.rules.turnSequence === "reinforcement" && state.phase !== "attack" && state.phase !== "redeploy") {
    return { ok: false, error: "end the turn after the attack phase" };
  }
  if (state.rules.victoryOptions) return completeTurn(state);
  // Pinned core-rules.md Victory: after this turn's move, before next income.
  if (state.rules.combat.capture === "choice" && checkVictory(state)) return { ok: true, state, outcome: null };
  const mover = activePlayer(state) as Player;
  state.log.push({ event: "turn_ended", player: mover.id, turn: state.turnNumber });
  const seats = state.players.length;
  for (let i = 0; i < seats; i++) {
    state.currentPlayer = (state.currentPlayer + 1) % seats;
    if (state.currentPlayer === 0) state.turnNumber += 1;
    if (!activePlayer(state)?.eliminated) break;
  }
  const next = activePlayer(state);
  state.phase = state.rules.turnSequence === "reinforcement" ? "reinforce" : "attack";
  state.capturedThisTurn = false;
  state.reinforcementPool = state.rules.turnSequence === "reinforcement" && next && !next.eliminated
    ? reinforcementIncome(state, next.id).total
    : 0;
  return { ok: true, state, outcome: null };
}

/** End-of-turn seam: later reward/effect work belongs before victory, never after handoff. */
function completeTurn(state: GameState): ApplyResult {
  if(state.rules.cards==='deck-v1' && state.cards && state.capturedThisTurn){
    const player=activePlayer(state)!.id;
    if(state.cards.hands[player]!.length===HAND_LIMIT){state.cards.pendingDiscard={player};return {ok:true,state,outcome:null};}
    drawReward(state);
  }
  return finalizeTurn(state);
}
function discardCard(state:GameState,index:number):ApplyResult {
  const c=state.cards,p=activePlayer(state)!.id;
  if(state.rules.cards!=='deck-v1'||!c?.pendingDiscard||c.pendingDiscard.player!==p)return {ok:false,error:'no card discard is pending'};
  if(!Number.isSafeInteger(index)||index<0||index>=c.hands[p]!.length)return {ok:false,error:'choose a card in your hand'};
  c.discardPile.push(c.hands[p]!.splice(index,1)[0]!);delete c.pendingDiscard;
  drawReward(state);return finalizeTurn(state);
}
function finalizeTurn(state: GameState): ApplyResult {
  state.log.push({ event: "turn_ended", player: activePlayer(state)!.id, turn: state.turnNumber });
  const handoff = nextLivingTurn(state);
  if (!resolveTurnVictory(state, handoff.completedRound)) beginNextTurn(state, handoff);
  return { ok: true, state, outcome: null };
}

function beginNextTurn(state: GameState, handoff = nextLivingTurn(state)): void {
  state.currentPlayer = handoff.seat;
  if (handoff.completedRound) state.turnNumber += 1;
  state.phase = state.rules.turnSequence === "reinforcement" ? "reinforce" : "attack";
  state.capturedThisTurn = false;
  state.reinforcementPool = state.rules.turnSequence === "reinforcement"
    ? reinforcementIncome(state, activePlayer(state)!.id).total : 0;
}

function humanLossChoice(state: GameState, choice: "watchComputers" | "stopGame"): ApplyResult {
  if (!state.rules.victoryOptions || state.phase !== "human-loss") {
    return { ok: false, error: "no human-loss choice is pending" };
  }
  if (choice === "stopGame") state.phase = "finished";
  else {
    state.watchingComputers = true;
    delete state.result;
    beginNextTurn(state);
  }
  return { ok: true, state, outcome: null };
}

function checkElimination(state: GameState): void {
  for (const candidate of state.players) {
    if (!candidate.eliminated && provincesOf(state, candidate.id).length === 0) {
      candidate.eliminated = true;
      if(state.cards){state.cards.discardPile.push(...state.cards.hands[candidate.id]!);state.cards.hands[candidate.id]=[];}
      state.log.push({ event: "eliminated", player: candidate.id, turn: state.turnNumber });
    }
  }
}

/** Conquest only, as in Classic. */
function checkVictory(state: GameState): boolean {
  if (!state.rules.victory.includes("conquest")) return false;
  const alive = livingPlayers(state);
  if (alive.length > 1) return false;
  state.phase = "finished";
  state.winner = alive[0]?.id ?? "";
  state.log.push({ event: "victory", player: state.winner, turn: state.turnNumber });
  return true;
}
import { initializeCards } from './cards';
import { generateBoardWithRng } from "./board-gen";
import type { BoardGenResult } from "./board-gen";
import { DeterministicRng } from "./rng";
import { validateGameOptions } from "./options";
import { malpacoRules } from "./state";
import { reinforcementIncome } from "./reinforcement";
import type { GameOptions } from "./options";
import type { GameMap, GameState, Player, RuleSet } from "./types";

/** C-STA-01..07: the generated deal always covers the design's 46 countries. */
export const DEAL_COUNTRY_COUNT = 46;
/** C-STA-03, decision 6: a computer share cannot be reduced below three. */
export const MIN_COMPUTER_COUNTRIES = 3;
/** C-CEN-01, C-CEN-04: exactly three uniformly drawn production centres. */
export const PRODUCTION_CENTRE_COUNT = 3;

export type CreateGameResult =
  | { readonly ok: true; readonly state: GameState }
  | { readonly ok: false; readonly errors: string[] };

/** Validate options, then generate and deal one complete game on a shared RNG stream. */
export function createGame(options: GameOptions, rules: RuleSet = malpacoRules()): CreateGameResult {
  const validated = validateGameOptions(options);
  return createGameValidated(validated, rules, new DeterministicRng(validated.seed), generateBoardWithRng);
}

/** Internal injection seam for stream and exhaustion acceptance tests. */
export function createGameWithRng(
  options: GameOptions,
  rng: DeterministicRng,
  boardBuilder: (rng: DeterministicRng) => BoardGenResult = generateBoardWithRng,
  rules: RuleSet = malpacoRules(),
): CreateGameResult {
  return createGameValidated(validateGameOptions(options), rules, rng, boardBuilder);
}

function createGameValidated(
  validated: GameOptions,
  rules: RuleSet,
  rng: DeterministicRng,
  boardBuilder: (rng: DeterministicRng) => BoardGenResult,
): CreateGameResult {
  const board = boardBuilder(rng);
  if (!board.ok) return { ok: false, errors: [...board.errors] };

  const players = makePlayers(validated);
  const firstSeat = rng.nextInt(0, players.length - 1);
  const order = Array.from({ length: players.length }, (_, i) => (firstSeat + i) % players.length);
  const shares = countryShares(players, order, validated.humanShare);
  const ids = rng.shuffled(board.map.provinces.map((province) => province.id));
  const ownerOf: Record<string, string> = {};
  let offset = 0;
  for (const seat of order) {
    for (let i = 0; i < shares[seat]!; i++) ownerOf[ids[offset++]!] = players[seat]!.id;
  }

  const repaired = repairCompleteIslands(board.map, ownerOf, rng);
  if (!repaired.ok) return { ok: false, errors: [repaired.error] };

  const top = validated.startingArmiesRange === "1-2" ? 2 : validated.startingArmiesRange === "1-3" ? 3 : 4;
  const armies: Record<string, number> = {};
  for (const id of ids) armies[id] = 1;
  for (const player of players) {
    const holdings = ids.filter((id) => ownerOf[id] === player.id);
    // C-STA-05: multiply before flooring so odd holdings round as specified.
    const total = Math.floor((1 + top) * holdings.length / 2);
    const eligible = holdings.slice();
    for (let n = holdings.length; n < total; n++) {
      const candidates = eligible.filter((id) => armies[id]! < top);
      const pick = candidates[rng.nextInt(0, candidates.length - 1)]!;
      armies[pick] = armies[pick]! + 1;
    }
  }
  // C-CEN-01, C-CEN-04: uniform sample after ownership repair and army spread.
  const productionCentres = rng.shuffled(ids).slice(0, PRODUCTION_CENTRE_COUNT);
  const computerRngs: Record<string, { seed: number; state: number }> = {};
  players.forEach((player, seat) => {
    if (player.kind === "computer") computerRngs[player.id] = DeterministicRng.subStream(validated.seed, seat).snapshot();
  });

  const state: GameState = {
      map: board.map, rules, players, ownerOf, armies, currentPlayer: firstSeat,
      phase: rules.turnSequence === "reinforcement" ? "reinforce" : "attack",
      reinforcementPool: 0, turnNumber: 1, capturedThisTurn: false, rng: rng.snapshot(), computerRngs,
      ...(rules.victoryOptions ? { roundOrigin: firstSeat } : {}),
      log: [{ event: "game_started", seed: validated.seed, players: players.length }],
      history: [], winner: "", productionCentres,
  };
  initializeCards(state,rng);
  if (rules.turnSequence === "reinforcement") {
    state.reinforcementPool = reinforcementIncome(state, players[firstSeat]!.id).total;
  }
  return { ok: true, state };
}

function makePlayers(options: GameOptions): Player[] {
  let computer = 0;
  return options.seats.map((seat, index) => {
    const base: Player = {
      id: `seat${index + 1}`, name: `Seat ${index + 1}`, kind: seat.kind, eliminated: false,
    };
    return seat.kind === "computer"
      ? { ...base, difficulty: options.computerStrengths[computer++]! }
      : base;
  });
}

/** Calculate base shares and apply each human adjustment in rotated turn order. */
export function countryShares(players: readonly Player[], order: readonly number[], humanShare: number): number[] {
  const base = Math.floor(DEAL_COUNTRY_COUNT / players.length);
  const shares = players.map(() => base);
  for (const seat of order.slice(players.length - (DEAL_COUNTRY_COUNT % players.length))) shares[seat]!++;
  const computers = order.filter((seat) => players[seat]!.kind === "computer");
  if (computers.length === 0 || computers.length === players.length || humanShare === 0) return shares;
  for (const human of order.filter((seat) => players[seat]!.kind === "human")) {
    if (humanShare > 0) {
      // C-STA-03, decision 6: largest computer share, later in turn order on ties.
      const source = [...computers].sort((a, b) => shares[b]! - shares[a]! || order.indexOf(b) - order.indexOf(a))[0]!;
      const moved = Math.min(humanShare, Math.max(0, shares[source]! - MIN_COMPUTER_COUNTRIES));
      shares[source]! -= moved;
      shares[human]! += moved;
    } else {
      // C-STA-03, decision 6: smallest computer share, earlier in turn order on ties.
      const target = [...computers].sort((a, b) => shares[a]! - shares[b]! || order.indexOf(a) - order.indexOf(b))[0]!;
      shares[human]! += humanShare;
      shares[target]! -= humanShare;
    }
  }
  return shares;
}

type RepairResult = { readonly ok: true } | { readonly ok: false; readonly error: string };

/** Swap owners without completing an island for either participant; returns failure if stuck. */
export function repairCompleteIslands(map: GameMap, ownerOf: Record<string, string>, rng: DeterministicRng): RepairResult {
  const completeIslands = () => map.islands.filter((island) => {
    const owner = ownerOf[island.provinces[0]!];
    return !!owner && island.provinces.every((id) => ownerOf[id] === owner);
  });
  let complete = completeIslands();
  while (complete.length > 0) {
    const before = new Map(map.islands.flatMap((island) => {
      const owner = ownerOf[island.provinces[0]!];
      return owner && island.provinces.every((id) => ownerOf[id] === owner) ? [[island.id, owner] as const] : [];
    }));
    const eligible: [string, string][] = [];
    const seenPairs = new Set<string>();
    const ids = map.provinces.map((province) => province.id);
    const sources = complete.flatMap((island) => island.provinces);
    for (const from of sources) {
      for (const to of ids) {
        const fromOwner = ownerOf[from]!;
        const toOwner = ownerOf[to]!;
        if (fromOwner === toOwner) continue;
        ownerOf[from] = toOwner;
        ownerOf[to] = fromOwner;
        const createsComplete = map.islands.some((island) => {
          const owner = ownerOf[island.provinces[0]!];
          return !!owner && island.provinces.every((id) => ownerOf[id] === owner) && before.get(island.id) !== owner;
        });
        ownerOf[from] = fromOwner;
        ownerOf[to] = toOwner;
        const key = [from, to].sort().join("\u0000");
        if (!createsComplete && !seenPairs.has(key)) {
          seenPairs.add(key);
          eligible.push([from, to]);
        }
      }
    }
    if (eligible.length === 0) return { ok: false, error: "unable to repair complete islands without completing another island" };
    const [a, b] = eligible[rng.nextInt(0, eligible.length - 1)]!;
    [ownerOf[a], ownerOf[b]] = [ownerOf[b]!, ownerOf[a]!];
    complete = completeIslands();
  }
  return { ok: true };
}
// C-SET-05/07: readable, versioned settings/seed and ordinary actions;
// reconstruct every rule/RNG value by replay, never from a saved snapshot.
import { validateGameOptions } from "./options";
import type { GameOptions } from "./options";
import { SaveFormatError } from "./save";
import { createGame } from "./setup";
import { apply } from "./rules";
import type { Action, GameState } from "./types";
import { referenceMap } from "./reference-map";
import { createReferenceGame } from "./reference-game";
import { createGeographicGame } from "./geographic-game";
import type {IslandGeography} from "./island-geography";
import { cardsRules, victoryRules } from "./state";

export const MATCH_SAVE_VERSION = 1;
function actionFrom(value: unknown, index: number): Action {
  const fail = (): never => { throw new SaveFormatError(`Action ${index + 1} has an invalid shape.`, `actions[${index}]`); };
  if (typeof value !== "object" || value === null || Array.isArray(value)) return fail();
  const a = value as Record<string, unknown>;
  const keys = a.kind === "reinforce" ? ["kind", "province", "amount"] : a.kind === "attack" ? ["kind", "from", "to"] : a.kind === "endTurn" || a.kind === "endReinforcement" ? ["kind"] : [];
  if (!keys.length || Object.keys(a).length !== keys.length || keys.some(k => !(k in a))) return fail();
  if (a.kind === "reinforce") {
    if (typeof a.province !== "string" || !a.province || typeof a.amount !== "number" || !Number.isSafeInteger(a.amount) || a.amount <= 0) return fail();
    return { kind: "reinforce", province: a.province, amount: a.amount };
  }
  if (a.kind === "attack") {
    if (typeof a.from !== "string" || !a.from || typeof a.to !== "string" || !a.to) return fail();
    return { kind: "attack", from: a.from, to: a.to };
  }
  return { kind: a.kind as "endTurn" | "endReinforcement" };
}
export function deserializeMatch(text: string): { options: GameOptions; state: GameState } {
  let value: unknown;
  try { value = JSON.parse(text); } catch { throw new SaveFormatError("Game file is not valid JSON."); }
  if (typeof value !== "object" || value === null || Array.isArray(value)) throw new SaveFormatError("Game file must be an object.");
  const obj = value as Record<string, unknown>;
  if (obj.version !== MATCH_SAVE_VERSION) throw new SaveFormatError(`Unsupported match version; expected ${MATCH_SAVE_VERSION}.`, "version");
  if (Object.keys(obj).length !== 3 || !Array.isArray(obj.actions)) throw new SaveFormatError("Game file needs version, options and an actions array.");
  let options: GameOptions;
  try { options = validateGameOptions(obj.options); } catch (e) { throw new SaveFormatError(`Invalid game options: ${e instanceof Error ? e.message : String(e)}`, "options"); }
  const actions = obj.actions.map(actionFrom);
  const created = createGame(options);
  if (!created.ok) throw new SaveFormatError(`Cannot generate this saved game: ${created.errors.join("; ")}. Try another game file.`);
  let state = created.state;
  for (let i = 0; i < actions.length; i++) {
    const result = apply(state, actions[i]!);
    if (!result.ok) throw new SaveFormatError(`Cannot replay action ${i + 1}: ${result.error}. Choose an intact game file.`, `actions[${i}]`);
    state = result.state;
  }
  return { options, state };
}
export function serializeMatch(options: GameOptions, actions: readonly Action[]): string {
  const text = JSON.stringify({ version: MATCH_SAVE_VERSION, options, actions });
  const validated = deserializeMatch(text);
  return JSON.stringify({ version: MATCH_SAVE_VERSION, options: validated.options, actions: validated.state.history }, null, 2);
}

/** [designed] T31 storage protocol: identities version algorithms, not positions.
 * Searched the existing options/match codecs: v1 identifies only its implicit
 * generated/malpaco path. Keep that path and its bytes unchanged above.
 */
export interface MatchIdentity {
  readonly boardGenerator: { readonly id: string; readonly version: number };
  readonly rules: { readonly id: string; readonly version: number };
  readonly actionSchemaVersion: number;
}

export const REFERENCE_MATCH_IDENTITY: MatchIdentity = Object.freeze({
  boardGenerator: Object.freeze({ id: "fixed-reference", version: 1 }),
  rules: Object.freeze({ id: "victory", version: 1 }),
  actionSchemaVersion: 2,
});
const LEGACY_MATCH_IDENTITY: MatchIdentity = Object.freeze({
  boardGenerator: Object.freeze({ id: "generated", version: 1 }),
  rules: Object.freeze({ id: "malpaco", version: 1 }),
  actionSchemaVersion: 1,
});

export interface LoadedVersionedMatch {
  readonly formatVersion: 1 | 2;
  readonly identity: MatchIdentity;
  readonly options: GameOptions;
  readonly state: GameState;
  /** Rebuilt metadata for the matching UI; never serialized as trusted state. */
  readonly geography?: IslandGeography;
  readonly initialState?: GameState;
}

function record(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

export const GEOGRAPHIC_MATCH_IDENTITY: MatchIdentity = Object.freeze({
  boardGenerator: Object.freeze({ id: "geographic", version: 1 }),
  rules: Object.freeze({ id: "victory", version: 1 }),
  actionSchemaVersion: 2,
});

/** [designed] T37 storage protocol, following the existing T31 identities.
 * Searched match codecs and pinned variety: no card wire format is prescribed.
 * cards/1 + schema 3 permanently selects deck-v1. Later trade/raid stages must
 * add exact tuples and preserve this factory, grammar and RNG timing.
 */
export const REFERENCE_CARD_MATCH_IDENTITY:MatchIdentity=Object.freeze({boardGenerator:Object.freeze({id:'fixed-reference',version:1}),rules:Object.freeze({id:'cards',version:1}),actionSchemaVersion:3});
export const GEOGRAPHIC_CARD_MATCH_IDENTITY:MatchIdentity=Object.freeze({boardGenerator:Object.freeze({id:'geographic',version:1}),rules:Object.freeze({id:'cards',version:1}),actionSchemaVersion:3});
function supportedIdentity(value: Record<string, unknown>): MatchIdentity {
  const generator = value.boardGenerator;
  const cardStage=record(value.rules)&&value.rules.id==='cards';
  const expected = record(generator) && generator.id === "geographic"
    ? (cardStage?GEOGRAPHIC_CARD_MATCH_IDENTITY:GEOGRAPHIC_MATCH_IDENTITY) : (cardStage?REFERENCE_CARD_MATCH_IDENTITY:REFERENCE_MATCH_IDENTITY);
  // Each supported generator keeps its exact rules/action tuple for replay.
  for (const field of ["boardGenerator", "rules"] as const) {
    const part = value[field], required = expected[field];
    if (!record(part) || Object.keys(part).length !== 2 || part.id !== required.id || part.version !== required.version) {
      throw new SaveFormatError(`Unsupported ${field}; expected ${required.id}/${required.version}.`, field);
    }
  }
  if (value.actionSchemaVersion !== expected.actionSchemaVersion) {
    throw new SaveFormatError(`Unsupported action schema version; expected ${expected.actionSchemaVersion}.`, "actionSchemaVersion");
  }
  return expected;
}

function versionedAction(value: unknown, index: number, schema: number): Action {
  const fail = (): never => { throw new SaveFormatError(`Action ${index + 1} has an invalid shape.`, `actions[${index}]`); };
  if (!record(value)) return fail();
  let keys: string[];
  switch (value.kind) {
    case 'discardCard':
      if(schema!==3||typeof value.handIndex!=='number'||!Number.isSafeInteger(value.handIndex)||value.handIndex<0)return fail();
      keys=['kind','handIndex'];break;
    case "reinforce": keys = ["kind", "province", "amount"]; break;
    case "attack":
    case "friendlyMove": keys = ["kind", "from", "to"]; break;
    case "endReinforcement":
    case "endTurn":
    case "captureMove":
    case "watchComputers":
    case "stopGame": keys = ["kind"]; break;
    default: return fail();
  }
  if ((value.kind === "captureMove" || value.kind === "friendlyMove") && Object.hasOwn(value, "amount")) keys.push("amount");
  if (Object.keys(value).length !== keys.length || keys.some(key => !Object.hasOwn(value, key))) return fail();
  for (const key of ["province", "from", "to"]) {
    if (keys.includes(key) && (typeof value[key] !== "string" || value[key].length === 0)) return fail();
  }
  if (keys.includes("amount") && (typeof value.amount !== "number" || !Number.isSafeInteger(value.amount) || value.amount <= 0)) return fail();
  return value as unknown as Action;
}

/** Rebuild from original options and recorded ordinary actions, without policy.
 * The baseline computer policy consumes no RNG. A future policy that does must
 * introduce a versioned replay protocol for its draws before claiming support.
 */
export function deserializeVersionedMatch(text: string): LoadedVersionedMatch {
  let value: unknown;
  try { value = JSON.parse(text); } catch { throw new SaveFormatError("Game file is not valid JSON."); }
  if (!record(value)) throw new SaveFormatError("Game file must be an object.");
  if (value.version === MATCH_SAVE_VERSION && !Object.hasOwn(value, "format")) {
    return { formatVersion: 1, identity: LEGACY_MATCH_IDENTITY, ...deserializeMatch(text) };
  }
  if (value.format !== "malpaco-match") throw new SaveFormatError("Unsupported match format; expected malpaco-match.", "format");
  if (value.version !== 2) throw new SaveFormatError("Unsupported match version; expected 2.", "version");
  const keys = ["format", "version", "boardGenerator", "rules", "actionSchemaVersion", "options", "actions"];
  if (Object.keys(value).length !== keys.length || keys.some(key => !Object.hasOwn(value, key)) || !Array.isArray(value.actions)) {
    throw new SaveFormatError("Game file needs exactly format, version, boardGenerator, rules, actionSchemaVersion, options and an actions array.");
  }
  const identity = supportedIdentity(value);
  let options: GameOptions;
  try { options = validateGameOptions(value.options); } catch (error) {
    throw new SaveFormatError(`Invalid game options: ${error instanceof Error ? error.message : String(error)}`, "options");
  }
  const actions = value.actions.map((action,index)=>versionedAction(action,index,identity.actionSchemaVersion));
  const rules=identity.rules.id==='cards'?cardsRules(options):victoryRules(options);
  const geographic=identity.boardGenerator.id==='geographic'?createGeographicGame(options,rules):null;
  const created=geographic??createReferenceGame(referenceMap,options,rules);
  if (!created.ok) throw new SaveFormatError(`Cannot generate this saved game: ${created.errors.join("; ")}.`, "boardGenerator");
  let state = created.state;
  for (let index = 0; index < actions.length; index++) {
    const result = apply(state, actions[index]!);
    if (!result.ok) throw new SaveFormatError(`Cannot replay action ${index + 1}: ${result.error}. Choose an intact game file.`, `actions[${index}]`);
    state = result.state;
  }
  return { formatVersion: 2, identity, options, state, initialState:created.state, ...(geographic?.ok ? {geography:geographic.geography} : {}) };
}

/** Validate through the same replay path before emitting a readable v2 file. */
export function serializeVersionedMatch(options: GameOptions, actions: readonly Action[], identity: MatchIdentity): string {
  const payload = {
    format: "malpaco-match", version: 2,
    boardGenerator: identity.boardGenerator, rules: identity.rules,
    actionSchemaVersion: identity.actionSchemaVersion, options, actions,
  };
  const validated = deserializeVersionedMatch(JSON.stringify(payload));
  return JSON.stringify({ ...payload, options: validated.options, actions: validated.state.history }, null, 2);
}
export * from "./types";
export { parseMap, province, neighbours, SCHEMA } from "./map";
export type { MapReadResult } from "./map";
export { DeterministicRng } from "./rng";
export type { DiceSource } from "./rng";
export { attackTargets, diceCount, pairResults, resolve, whyNot, DIE_SIDES } from "./combat";
export { apply, legalAttacks } from "./rules";
export { friendlyTargets, friendlySources, whyNotFriendlyMove } from "./movement";
export {
  activePlayer,
  armyCount,
  armyTotal,
  classicRules,
  captureChoiceRules,
  friendlyMoveRules,
  victoryRules,
  cloneState,
  livingPlayers,
  malpacoRules,
  newGame,
  newGameFromOptions,
  ownerOf,
  provincesOf,
} from "./state";
export { islandIncome, type IslandIncome } from "./bonuses";
export { reinforcementIncome, type ReinforcementIncome } from "./reinforcement";
export { createGame } from "./setup";
