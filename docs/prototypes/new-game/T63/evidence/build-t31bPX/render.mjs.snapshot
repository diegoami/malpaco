import {svg as selectedSvg} from '../T60/render.mjs';
const esc=s=>String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('"','&quot;');
// Preserve the chosen A drawing; only accessibility state attributes are added.
export const svg=board=>selectedSvg(board).replaceAll('role="button"','role="button" aria-pressed="false"');
export function html(board){
 const islands=board.islands.map(i=>`<p>${esc(i.name)}: +${i.bonus}; ${i.provinces.length} countries</p>`).join('');
 return `<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Seed 1994 · Nine Isles reference</title>
<style>*{box-sizing:border-box}body{margin:0;background:#193e51;color:#f8f2e2;font:14px system-ui;height:100vh;display:grid;grid-template-rows:80px minmax(0,1fr)}header{padding:10px 14px;background:#102e3e;display:grid;grid-template-columns:1fr auto;align-content:center;gap:5px}h1{font:600 17px Georgia;margin:0}button{font:inherit;color:inherit;background:#254e60;border:1px solid #78939d;border-radius:5px;padding:5px 9px;cursor:pointer}button:focus-visible{outline:3px solid #f5dc82}.controls{display:flex;gap:8px}#selection{font-size:12px;grid-column:1/-1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}main{min-height:0;display:grid;place-items:center}svg{width:100%;height:100%;display:block}aside{position:fixed;right:10px;top:84px;bottom:10px;width:350px;max-width:calc(100vw - 20px);padding:16px;background:#102e3ef5;border:1px solid #86a5ad;border-radius:8px;overflow:auto}aside h2{font-size:18px}aside p{font-size:13px}#inspector[hidden]{display:none}</style>
<header><h1>Seed 1994 · Nine Isles</h1><div class="controls"><button id="inspect" aria-expanded="false" aria-controls="inspector">Topology</button><button id="export">Export SVG</button></div><span id="selection" aria-live="polite">Select a country · Blue S1 / Amber S2 · ★ production</span></header>
<main id="board">${svg(board)}</main><aside id="inspector" hidden><h2>Reference topology</h2><p>46 countries · 9 islands · 61 land borders · 15 sea crossings.</p><p>Click, Enter or Space selects a country. Arrow keys move focus. Gold outlines show neighbours; bright routes show incident sea links.</p><h3>Island income</h3>${islands}</aside>
<script>window.REFERENCE_BOARD=${JSON.stringify(board).replaceAll('<','\\u003c')};
(()=>{const B=window.REFERENCE_BOARD,nodes=[...document.querySelectorAll('.country')];
function select(id){const p=B.provinces.find(p=>p.id===id),neighbors=new Set([...p.borders,...p.seaLanes]);for(const n of nodes){n.classList.toggle('selected',n.dataset.id===id);n.classList.toggle('neighbor',neighbors.has(n.dataset.id));n.setAttribute('aria-pressed',String(n.dataset.id===id));n.tabIndex=n.dataset.id===id?0:-1;}for(const lane of document.querySelectorAll('.lane'))lane.classList.toggle('active',lane.dataset.edge.split('|').includes(id));document.querySelector('#selection').textContent=p.name+' · '+p.owner+' · '+p.armies+' armies · Neighbours: '+[...neighbors].map(id=>B.provinces.find(q=>q.id===id).name).join(', ');}
for(const[j,n]of nodes.entries()){n.onclick=()=>select(n.dataset.id);n.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();select(n.dataset.id);}if(['ArrowRight','ArrowDown','ArrowLeft','ArrowUp'].includes(e.key)){e.preventDefault();nodes[(j+(['ArrowRight','ArrowDown'].includes(e.key)?1:nodes.length-1))%nodes.length].focus();}};}
document.querySelector('#inspect').onclick=()=>{const panel=document.querySelector('#inspector');panel.hidden=!panel.hidden;document.querySelector('#inspect').setAttribute('aria-expanded',String(!panel.hidden));};
document.querySelector('#export').onclick=()=>{const blob=new Blob([new XMLSerializer().serializeToString(document.querySelector('svg'))],{type:'image/svg+xml'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='seed-1994-coast-first.svg';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);};})();</script></html>`;
}
