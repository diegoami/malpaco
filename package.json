{
  "name": "malpaco-spike-ts",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "An original turn-based island-conquest game with seeded maps and local play.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p src/core && tsc --noEmit && vite build",
    "package:playable": "node tools/release/package-playable.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "node --test tests/dev-watch/*.test.mjs && vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
